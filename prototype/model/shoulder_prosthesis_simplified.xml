<mujoco model="shoulder_prosthesis_control_prototype">
  <!--
    Equivalent kinematic prototype, not a CAD-derived mechanism model.
    Dimensions, axes, limits and inertial properties below are temporary.

    Pick-and-place contacts are compiled in so MuJoCo keeps the pairs. The home
    keyframe parks that stage and the cubes below the floor; the web app lifts
    them into the workspace only in PAP experiment mode. World gravity stays off
    so the arm tracks the same way as the reach demo. The web app applies cube
    weight directly while a PAP trial is running.
  -->
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.18 0.22 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <default>
    <joint damping="2" armature="0.02"/>
    <geom contype="0" conaffinity="0" density="800" friction="0.8 0.02 0.001"
          rgba="0.28 0.48 0.72 1"/>
    <position kp="120" kv="18"/>
    <default class="pap_contact">
      <geom contype="1" conaffinity="1" condim="3" friction="1.2 0.01 0.001"
            solref="0.008 1" solimp="0.95 0.99 0.001 0.5 2"/>
    </default>
    <default class="cube">
      <geom contype="1" conaffinity="1" condim="4" friction="2.2 0.06 0.002"
            solref="0.008 1" solimp="0.95 0.99 0.001 0.5 2" density="420" priority="1"/>
      <joint damping="0.04" armature="0.00002"/>
    </default>
  </default>

  <asset>
    <material name="base_mat" rgba="0.18 0.22 0.28 1"/>
    <material name="upper_mat" rgba="0.22 0.52 0.78 1"/>
    <material name="forearm_mat" rgba="0.18 0.68 0.58 1"/>
    <material name="hand_mat" rgba="0.90 0.58 0.20 1"/>
    <material name="target_mat" rgba="0.95 0.18 0.18 0.70"/>
    <material name="zone_a_mat" rgba="0.16 0.46 0.95 1"/>
    <material name="zone_b_mat" rgba="0.95 0.50 0.14 1"/>
    <material name="letter_mat" rgba="0.04 0.07 0.12 1"/>
  </asset>

  <worldbody>
    <light pos="1 -1 2.8" dir="-0.4 0.3 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" pos="0 0 0" rgba="0.12 0.14 0.18 1"/>

    <!-- Fixed shoulder base. The arm's neutral pose points downward. -->
    <body name="fixed_base" pos="0 0 1.15">
      <geom name="base_plate" type="box" size="0.10 0.14 0.10" pos="0.05 0 0.08" material="base_mat"/>
      <geom name="base_post" type="cylinder" size="0.055 0.13" pos="0 0 -0.08" material="base_mat"/>

      <!-- Positive shoulder flexion moves the arm toward model -X (defined as forward). -->
      <body name="shoulder_flexion_frame">
        <joint name="shoulder_flexion" type="hinge" axis="0 1 0" range="-30 100"/>
        <geom name="shoulder_pitch_hub" type="cylinder" size="0.07 0.075" quat="0.707107 0 0.707107 0"
              material="upper_mat"/>

        <!-- Positive shoulder abduction moves the arm toward model +Y. -->
        <body name="shoulder_abduction_frame">
          <joint name="shoulder_abduction" type="hinge" axis="1 0 0" range="-10 90"/>
          <geom name="shoulder_roll_hub" type="sphere" size="0.075" material="upper_mat"/>
          <geom name="upper_arm" type="capsule" fromto="0 0 -0.04 0 0 -0.34" size="0.047"
                material="upper_mat"/>

          <!-- Temporary interpretation: forearm forward/back = elbow/forearm pitch. -->
          <body name="forearm_frame" pos="0 0 -0.36">
            <joint name="forearm_pitch" type="hinge" axis="0 1 0" range="-20 110"/>
            <geom name="elbow_hub" type="cylinder" size="0.055 0.06" quat="0.707107 0 0.707107 0"
                  material="forearm_mat"/>
            <geom name="forearm" type="capsule" fromto="0 0 -0.04 0 0 -0.31" size="0.041"
                  material="forearm_mat"/>

            <body name="hand" pos="0 0 -0.34">
              <geom name="palm" type="box" size="0.065 0.035 0.075" pos="0 0 -0.05" material="hand_mat"/>

              <!-- One logical aperture DOF. The right finger is constrained to mirror the left.
                   Pads stay clear of cube contacts; the web app attaches a nearby cube when the hand closes. -->
              <body name="left_finger" pos="0.024 0 -0.118">
                <joint name="hand_aperture_left" type="slide" axis="1 0 0" range="0 0.035" damping="3" armature="0.001"/>
                <geom name="left_finger_geom" type="box" size="0.010 0.016 0.014" pos="0 0 -0.064"
                      material="hand_mat"/>
              </body>
              <body name="right_finger" pos="-0.024 0 -0.118">
                <joint name="hand_aperture_right" type="slide" axis="-1 0 0" range="0 0.035" damping="3" armature="0.001"/>
                <geom name="right_finger_geom" type="box" size="0.010 0.016 0.014" pos="0 0 -0.064"
                      material="hand_mat"/>
              </body>

              <site name="end_effector" type="sphere" size="0.012" pos="0 0 -0.19" rgba="1 0.9 0.1 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!--
      PAP stage. With the demo camera replaced by azimuth 90, -X is screen-left (zone A)
      and +X is screen-right (zone B). Platform top is z=0.25. The free joint is locked
      from the web app so the table cannot fall when gravity is enabled.
    -->
    <body name="pap_stage" pos="0 0 0">
      <freejoint name="pap_stage_free"/>
      <inertial pos="0 0 0" mass="200" diaginertia="8 8 8"/>
      <geom name="pap_platform" class="pap_contact" type="box" size="0.50 0.34 0.018" pos="0 0.02 0.232"
            rgba="0.14 0.16 0.20 1"/>
      <geom name="pap_zone_a" type="box" size="0.12 0.18 0.001" pos="-0.17 0.02 0.2506" material="zone_a_mat"/>
      <geom name="pap_zone_b" type="box" size="0.12 0.18 0.001" pos="0.17 0.02 0.2506" material="zone_b_mat"/>
      <!-- Narrow pedestals lift the cubes into the pinch without the fingertips hitting the mat. -->
      <geom name="pap_pedestal_1" class="pap_contact" type="box" size="0.007 0.007 0.018" pos="-0.24 0.10 0.268" rgba="0.28 0.32 0.38 1"/>
      <geom name="pap_pedestal_2" class="pap_contact" type="box" size="0.007 0.007 0.018" pos="-0.24 0.00 0.268" rgba="0.28 0.32 0.38 1"/>
      <geom name="pap_pedestal_3" class="pap_contact" type="box" size="0.007 0.007 0.018" pos="-0.24 -0.10 0.268" rgba="0.28 0.32 0.38 1"/>
      <geom name="pap_pedestal_4" class="pap_contact" type="box" size="0.007 0.007 0.018" pos="-0.14 0.06 0.268" rgba="0.28 0.32 0.38 1"/>
      <geom name="pap_pedestal_5" class="pap_contact" type="box" size="0.007 0.007 0.018" pos="-0.14 -0.06 0.268" rgba="0.28 0.32 0.38 1"/>
      <!-- Rims sit outside the hand's reachable pinch so they do not block a top-down grasp. -->
      <geom name="pap_rim_nx" class="pap_contact" type="box" size="0.012 0.34 0.012" pos="-0.488 0.02 0.274"
            rgba="0.22 0.26 0.32 1"/>
      <geom name="pap_rim_px" class="pap_contact" type="box" size="0.012 0.34 0.012" pos="0.488 0.02 0.274"
            rgba="0.22 0.26 0.32 1"/>
      <geom name="pap_rim_ny" class="pap_contact" type="box" size="0.50 0.012 0.012" pos="0 -0.308 0.274"
            rgba="0.22 0.26 0.32 1"/>
      <geom name="pap_rim_py" class="pap_contact" type="box" size="0.50 0.012 0.012" pos="0 0.348 0.274"
            rgba="0.22 0.26 0.32 1"/>
      <!-- Block letters sit on the near edge of each mat (toward +Y, the PAP camera). -->
      <geom name="pap_letter_a_l" type="box" size="0.006 0.004 0.032" pos="-0.188 0.155 0.298"
            euler="0 24 0" material="letter_mat"/>
      <geom name="pap_letter_a_r" type="box" size="0.006 0.004 0.032" pos="-0.152 0.155 0.298"
            euler="0 -24 0" material="letter_mat"/>
      <geom name="pap_letter_a_bar" type="box" size="0.016 0.004 0.006" pos="-0.170 0.155 0.290"
            material="letter_mat"/>
      <geom name="pap_letter_b_spine" type="box" size="0.006 0.004 0.032" pos="0.150 0.155 0.298"
            material="letter_mat"/>
      <geom name="pap_letter_b_top" type="box" size="0.016 0.004 0.011" pos="0.168 0.155 0.316"
            material="letter_mat"/>
      <geom name="pap_letter_b_mid" type="box" size="0.014 0.004 0.006" pos="0.166 0.155 0.298"
            material="letter_mat"/>
      <geom name="pap_letter_b_bot" type="box" size="0.016 0.004 0.011" pos="0.168 0.155 0.280"
            material="letter_mat"/>
    </body>

    <!-- 24 mm cubes fit inside the closed pinch (26 mm) and rest 1 mm above the pedestals. -->
    <body name="pap_cube_1" pos="-0.24 0.10 0.299" childclass="cube">
      <freejoint name="pap_cube_1_free"/>
      <geom name="pap_cube_1_geom" type="box" size="0.012 0.012 0.012" rgba="0.96 0.82 0.22 1"/>
    </body>
    <body name="pap_cube_2" pos="-0.24 0.00 0.299" childclass="cube">
      <freejoint name="pap_cube_2_free"/>
      <geom name="pap_cube_2_geom" type="box" size="0.012 0.012 0.012" rgba="0.93 0.94 0.96 1"/>
    </body>
    <body name="pap_cube_3" pos="-0.24 -0.10 0.299" childclass="cube">
      <freejoint name="pap_cube_3_free"/>
      <geom name="pap_cube_3_geom" type="box" size="0.012 0.012 0.012" rgba="0.90 0.42 0.38 1"/>
    </body>
    <body name="pap_cube_4" pos="-0.14 0.06 0.299" childclass="cube">
      <freejoint name="pap_cube_4_free"/>
      <geom name="pap_cube_4_geom" type="box" size="0.012 0.012 0.012" rgba="0.42 0.82 0.55 1"/>
    </body>
    <body name="pap_cube_5" pos="-0.14 -0.06 0.299" childclass="cube">
      <freejoint name="pap_cube_5_free"/>
      <geom name="pap_cube_5_geom" type="box" size="0.012 0.012 0.012" rgba="0.62 0.48 0.92 1"/>
    </body>

    <!-- Target geoms render in both native MuJoCo and Mjswan; sites retain exact telemetry anchors. -->
    <geom name="target_1_visual" type="sphere" size="0.035" pos="-0.45 0.22 0.72" material="target_mat"/>
    <geom name="target_2_visual" type="sphere" size="0.035" pos="-0.30 -0.35 0.82" material="target_mat"/>
    <geom name="target_3_visual" type="sphere" size="0.035" pos="-0.15 0.38 0.55" material="target_mat"/>
    <site name="target_1" type="sphere" size="0.001" pos="-0.45 0.22 0.72" rgba="0 0 0 0"/>
    <site name="target_2" type="sphere" size="0.001" pos="-0.30 -0.35 0.82" rgba="0 0 0 0"/>
    <site name="target_3" type="sphere" size="0.001" pos="-0.15 0.38 0.55" rgba="0 0 0 0"/>
  </worldbody>

  <equality>
    <joint name="symmetric_hand_aperture" joint1="hand_aperture_right" joint2="hand_aperture_left"
           polycoef="0 1 0 0 0" solref="0.005 1"/>
  </equality>

  <actuator>
    <position name="shoulder_flexion_servo" joint="shoulder_flexion" kp="140" kv="22"/>
    <position name="shoulder_abduction_servo" joint="shoulder_abduction" kp="140" kv="22"/>
    <position name="forearm_pitch_servo" joint="forearm_pitch" kp="110" kv="16"/>
    <position name="hand_aperture_servo" joint="hand_aperture_left" kp="420" kv="22" forcerange="-18 18"/>
  </actuator>

  <sensor>
    <jointpos name="shoulder_flexion_position" joint="shoulder_flexion"/>
    <jointpos name="shoulder_abduction_position" joint="shoulder_abduction"/>
    <jointpos name="forearm_pitch_position" joint="forearm_pitch"/>
    <jointpos name="hand_aperture_position" joint="hand_aperture_left"/>
    <framepos name="end_effector_position" objtype="site" objname="end_effector"/>
  </sensor>

  <keyframe>
    <!-- Keyframe/actuator control values use MuJoCo's internal radians, even with compiler angle="degree". -->
    <key name="home"
         qpos="0.1745329252 0.1745329252 0.7853981634 0.015 0.015 0 0 -8 1 0 0 0 -0.24 0.10 -8 1 0 0 0 -0.24 0.00 -8 1 0 0 0 -0.24 -0.10 -8 1 0 0 0 -0.14 0.06 -8 1 0 0 0 -0.14 -0.06 -8 1 0 0 0"
         ctrl="0.1745329252 0.1745329252 0.7853981634 0.015"/>
  </keyframe>
</mujoco>
